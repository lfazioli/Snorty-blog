# Public URL of the deployed site, no trailing slash.
# This must be the host the site actually answers on: www.snorty.space serves the
# site and snorty.space returns a 308 to it. Pointing these at the apex makes every
# canonical link, og:url and sitemap entry reference a URL that redirects.
# VITE_SITE_URL is inlined at build time, so changing it requires a redeploy.
SITE_URL=https://www.snorty.space
VITE_SITE_URL=https://www.snorty.space

# Existing administrator account allowed to sign in (server-side only).
ADMIN_EMAIL=your-admin-email@example.com
