{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    { "src": "/sitemap\\.xml", "dest": "/api/seo?kind=sitemap" },
    { "src": "/robots\\.txt", "dest": "/api/seo?kind=robots" },
    { "src": "/feed\\.xml", "dest": "/api/seo?kind=feed" },
    { "src": "/rss\\.xml", "status": 301, "headers": { "Location": "/feed.xml" } },
    { "src": "/api/auth/(?:register|forgot|reset)/?", "dest": "/api/auth/retired" },
    { "src": "/", "dest": "/api/page?path=/" },
    { "handle": "filesystem" },
    { "src": "/((?!api/).*)", "dest": "/api/page?path=/$1" }
  ]
}
